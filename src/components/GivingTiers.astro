---
import Eyebrow from './Eyebrow.astro';
import { tiers } from '../data/tiers.js';
import { img } from '../data/images.js';
const { title = "Support a child's<br />whole year", eyebrow = 'Ways to give', padTop = true } = Astro.props;
---
<section class="section section--cream" id="give" style={padTop ? '' : 'padding-top:0'}>
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <Eyebrow text={eyebrow} />
        <h2 set:html={title} />
      </div>
      <div class="toggle" id="cycleToggle">
        <button class="is-on" data-cycle="month" type="button">Monthly</button>
        <button data-cycle="year" type="button">Yearly</button>
      </div>
    </div>

    <div class="plans reveal">
      {tiers.map((t) => (
        <div class={`plan plan--${t.tone}`}>
          <div>
            <h4>{t.name}</h4>
            <p>{t.blurb}</p>
            <div class="plan__price">
              <span data-price data-month={t.monthly} data-year={t.yearly}>{t.monthly}</span>
              <small data-period>/Month</small>
            </div>
            <a href="/donate" class={`btn btn--${t.ctaStyle}`}>
              {t.cta}<span class="btn__dot"><svg><use href="#i-arrow" /></svg></span>
            </a>
            <ul class="plan__list">
              <strong>What your gift covers</strong>
              {t.includes.map((i) => (
                <li><svg><use href="#i-check" /></svg> {i}</li>
              ))}
            </ul>
          </div>
          {t.featured && (
            <div class="plan__media"><img src={img.educatorChild} alt="" loading="lazy" /></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
