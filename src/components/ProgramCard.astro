---
import { url } from '../lib/url.js';
const { program } = Astro.props;
---
<article class={`prog prog--${program.tone} reveal`}>
  <div class="prog__body">
    <div class="prog__num">{program.number}</div>
    <h3>{program.title}</h3>
    <p>{program.excerpt}</p>
    <span class={`badge badge--${program.badge}`}>{program.ages}</span>
    <div class="prog__foot">
      <a href={url(`/programs/${program.slug}`)} class="link-arrow">View details <svg><use href="#i-arrow" /></svg></a>
    </div>
  </div>
  <div class="prog__media"><img src={program.image} alt={program.title} loading="lazy" /></div>
</article>
