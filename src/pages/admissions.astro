---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';

const steps = [
  { n: '1', title: 'Get in touch',    text: 'Call, message, or walk into any centre. No appointment needed.' },
  { n: '2', title: 'Visit with your child', text: 'Spend a morning in the classroom so you both see how it works.' },
  { n: '3', title: 'Bring what you have', text: 'Any ID and proof of age helps. If you do not have papers, we will still enrol.' },
  { n: '4', title: 'Start the next Monday', text: 'Placement is by age and readiness. Uniform and books are issued on day one.' },
];
---
<Base title="Admissions" description="How to enrol a child at an Indo-Global Skills & Edu Foundation centre. No fees, no paperwork barrier.">
  <PageHero
    eyebrow="Admissions"
    title="Enrolling takes one visit"
    lede="There is no fee, no entrance test, and no deadline. If a seat is open, your child can start the following week."
    crumb="Admissions"
  />

  <section class="section section--white">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:44px">
        <Eyebrow text="How it works" />
        <h2>Four steps, start to finish</h2>
      </div>
      <div class="steps reveal">
        {steps.map((s) => (
          <div class="step"><b>{s.n}</b><h4>{s.title}</h4><p>{s.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--canvas" style="padding-top:0">
    <div class="wrap">
      <div class="faq reveal">
      <Eyebrow text="Questions" />
      <h2 style="margin-bottom:20px">What parents ask us</h2>
      <details open>
        <summary>Is it really free?</summary>
        <p>Yes — including uniform, books, materials, and a daily meal. We never ask families for money.</p>
      </details>
      <details>
        <summary>What if we have no birth certificate?</summary>
        <p>We enrol the child anyway and help you apply for documents afterwards. Missing paperwork is never a reason to turn a child away.</p>
      </details>
      <details>
        <summary>What are the timings?</summary>
        <p>Most centres run two shifts, 8:30–11:30am and 12:30–3:30pm. We will place your child in whichever fits your household.</p>
      </details>
      <details>
        <summary>What if the centre is full?</summary>
        <p>You go on the waiting list for that centre and we tell you which nearby centres have space now. Waits are usually a few weeks.</p>
      </details>
      <div style="margin-top:34px">
        <Button href="/contact" variant="purple">Ask about a seat</Button>
      </div>
      </div>
    </div>
  </section>

  <CTA title="Know a family who needs this?" text="Most of our enrolments come from a neighbour telling someone we exist." cta="Share our details" href="/contact" />
</Base>
