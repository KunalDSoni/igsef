---
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import CTA from '../../components/CTA.astro';
import { posts } from '../../data/posts.js';
import { url } from '../../lib/url.js';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const more = posts.filter((p) => p.slug !== post.slug);
---
<Base title={post.title} description={post.excerpt}>
  <section class="page-hero">
    <div class="wrap">
      <Eyebrow text="Our blogs" />
      <h1>{post.title}</h1>
      <div class="crumbs"><a href={url('/blog')}>Blog</a> · {post.author} · {post.date}</div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap article">
      <div>
        <div class="article__media"><img src={post.image} alt="" /></div>
        <div class="prose">
          {post.body.map((para) => <p>{para}</p>)}
        </div>
      </div>
      <aside class="aside">
        <h4>In this piece</h4>
        <ul>
          <li><svg><use href="#i-check" /></svg> {post.excerpt}</li>
          <li><svg><use href="#i-check" /></svg> Written by {post.author}</li>
          <li><svg><use href="#i-check" /></svg> Published {post.date}</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--cream" style="padding-top:0">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:34px"><h2>More reading</h2></div>
      <div class="blog__grid reveal">
        {more.map((p) => <BlogCard post={p} />)}
      </div>
    </div>
  </section>

  <CTA />
</Base>
