---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { teachers } from '../data/teachers.js';
---
<Base title="Teachers" description="The educators running our classrooms, most of them trained through our own programme.">
  <PageHero
    eyebrow="Our team"
    title="The people in the room"
    lede="Most of our educators grew up in the neighbourhoods they now teach in. Several started as parents of enrolled children."
    crumb="Teachers"
  />
  <section class="section section--white">
    <div class="wrap">
      <div class="team reveal">
        {teachers.map((t) => (
          <article class="tmember">
            <div class="tmember__photo"><img src={t.photo} alt={t.name} loading="lazy" /></div>
            <div class="tmember__body">
              <h4>{t.name}</h4>
              <div class="tmember__role">{t.role} · {t.centre}</div>
              <p>{t.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CTA title="We are hiring educators" text="If you have taught young children — formally or not — we would like to hear from you." cta="Get in touch" href="/contact" />
</Base>
