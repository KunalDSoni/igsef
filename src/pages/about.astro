---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Marquee from '../components/Marquee.astro';
import CTA from '../components/CTA.astro';
import { stats } from '../data/site.js';
import { img } from '../data/images.js';

const milestones = [
  { label: 'Getting started', text: 'Started with one rented room in Kalina and nineteen children.' },
  { label: 'Growing',         text: 'Opened our fifth centre and hired the first educators trained in-house.' },
  { label: 'Widening scope',  text: 'Launched the bridge programme for children aged nine to twelve.' },
  { label: 'Today',           text: '38 centres, 2,400 children, and a 96% daily attendance rate.' },
];
---
<Base title="About" description="Why Indo-Global Skills & Edu Foundation exists, how we work, and what we have learned running free classrooms.">
  <PageHero
    eyebrow="About us"
    title="A classroom should not depend on what a family can pay"
    lede="We run free early-learning centres in neighbourhoods where the nearest affordable school is too far, too full, or too expensive."
    crumb="About"
  />

  <section class="section section--white">
    <div class="wrap why reveal">
      <div class="why__photo"><img src={img.educatorChild} alt="An educator reading with a child" loading="lazy" /></div>
      <div>
        <Eyebrow text="Our story" />
        <h2>We started with<br />nineteen children</h2>
        <div class="prose" style="margin-top:20px">
          <p>The foundation began in a rented room in Kalina, because a group of parents could not find anywhere to send their four-year-olds.</p>
          <p>Since then, the model has not changed much. We open small centres inside the neighbourhoods families already live in, keep class sizes under twelve, and hire educators from those same communities. What changed is the number of children — from nineteen to more than two thousand.</p>
          <p>We charge nothing. Not a registration fee, not a materials fee, not a uniform deposit. The moment a family has to weigh school against groceries, attendance drops, and the child who stops coming rarely comes back.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="stats reveal">
        {stats.map((s) => (<div class="stat"><b>{s.value}</b><span>{s.label}</span></div>))}
      </div>
    </div>
  </section>

  <Marquee text="Where growth begins" />

  <section class="section section--white">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:44px">
        <Eyebrow text="How we got here" />
        <h2>One method, start to now</h2>
      </div>
      <div class="steps reveal">
        {milestones.map((m, i) => (
          <div class="step"><b>{i + 1}</b><h4>{m.label}</h4><p>{m.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap philo reveal">
      <div>
        <Eyebrow text="What we believe" />
        <h2>Guided by care<br />and creativity</h2>
        <p>Three commitments shape every decision we make, from how we hire to how we spend.</p>
      </div>
      <div class="philo__rail">
        <article class="pcard pcard--mint">
          <div class="pcard__icon"><svg><use href="#i-heart" /></svg></div>
          <h4>Free means free</h4>
          <p>No fees of any kind, including the hidden ones. Uniforms, books, and meals are all covered.</p>
        </article>
        <article class="pcard pcard--lav">
          <div class="pcard__icon"><svg><use href="#i-book" /></svg></div>
          <h4>Small classrooms</h4>
          <p>Never more than twelve children per educator. It is expensive, and it is the reason the work holds.</p>
        </article>
        <article class="pcard pcard--peach">
          <div class="pcard__icon"><svg><use href="#i-globe" /></svg></div>
          <h4>Hire from the street</h4>
          <p>Most of our educators grew up in the neighbourhoods they teach in, and trained through our own programme.</p>
        </article>
      </div>
    </div>
  </section>

  <CTA title="Help us open the next centre" cta="Ways to give" />
</Base>
