---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found">
  <section class="nf">
    <div class="wrap">
      <div class="nf__code">404</div>
      <h2>This page went out to play</h2>
      <p>The page you were looking for has moved or never existed. Everything else is still where you left it.</p>
      <Button href="/" variant="purple">Back to home</Button>
    </div>
  </section>
</Base>
